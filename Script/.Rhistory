ind_empleo ~ i(periodo_imp, IVIG_3_dt, ref = -1) +
cobertura +
log(población) + log(SGP) |
departamento + ym,
data = BD_event_imp,
cluster = ~departamento
)
etable(modelo_event_imp,
digits = 4,
