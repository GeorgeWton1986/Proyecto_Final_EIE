# Modelo con interacciones departamento × shock
modelo_het_depto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:departamento +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por departamento estimado\n\n")
etable(modelo_het_depto,
title = "Heterogeneidad por departamento",
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × vulnerable",
"cobertura" = "Cobertura de gas",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
# Extraer coeficientes de departamentos
coefs_depto <- coef(modelo_het_depto)
nombres_depto <- names(coefs_depto)[grepl("departamento", names(coefs_depto))]
valores_depto <- coefs_depto[nombres_depto]
# Limpiar nombres
nombres_limpios <- gsub("Shock_Importacion:IVIG_3_dt:departamento", "", nombres_depto)
# Crear dataframe
df_plot <- data.frame(
departamento = nombres_limpios,
coef = valores_depto,
se = se(modelo_het_depto)[nombres_depto]
) %>%
mutate(
ci_low = coef - 1.96 * se,
ci_high = coef + 1.96 * se,
significativo = ifelse(ci_low > 0 | ci_high < 0, "Sí", "No")
)
# Gráfico
ggplot(df_plot, aes(x = reorder(departamento, coef), y = coef)) +
geom_point(aes(color = significativo), size = 3) +
geom_errorbar(aes(ymin = ci_low, ymax = ci_high, color = significativo),
width = 0.2, linewidth = 1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
coord_flip() +
labs(title = "Efectos Heterogéneos por Departamento",
subtitle = "Shock Importación × Vulnerabilidad (con IC 95%)",
x = "Departamento",
y = "Efecto estimado",
color = "Significativo (5%)") +
theme_minimal() +
scale_color_manual(values = c("No" = "gray", "Sí" = "red"))
