# Definir URL del archivo en GitHub
github_url <- "https://raw.githubusercontent.com/GeorgeWton1986/Proyecto_Final_EIE/main/Data/20251116_DB.xlsx"
temp_file <- tempfile(fileext = ".xlsx")
download.file(github_url, temp_file, mode = "wb")
# Cargar datos usando readxl
BD_0 <- read_excel(temp_file)
# Mostrar los primeros 5 registros de la base de datos
kable(head(BD_0, 5),
format = "latex",
booktabs = TRUE,
caption = "Primeros 5 registros de la base de datos",
digits = 2)%>%
kable_styling(font_size=7,
latex_options = c("hold_position","scale_down"))
# Tabla de estadísticas descriptivas
estadisticas <- BD_0 %>%
summary() %>%
as.data.frame()
kable(estadisticas,
format = "latex",
booktabs = TRUE,
caption = "Estadísticas descriptivas de la base de datos",
digits = 2)%>%
kable_styling(font_size=7,
latex_options = c("hold_position","scale_down"))
# Eliminar archivo temporal
unlink(temp_file)
# Eliminar Textiles, confecciones y cuero solo de risaralda
BD_0 <- BD_0 %>%
filter( industria != "Curtido de cuero y calzado"& industria != "Textiles y confecciones")
# Definir el periodo de referencia pre-tratamiento
fecha_pre_tratamiento <- as.Date("2024-12-01")   # Inicio importación GNI
# Filtrar la base según nuestro shock
BD_pre_tratamiento <- BD_0 %>%
filter(date < fecha_pre_tratamiento)
# Calcular min/max pre-tratamiento según shock
min_costotransporte <- min(BD_pre_tratamiento$costotransporte, na.rm = TRUE)
max_costotransporte <- max(BD_pre_tratamiento$costotransporte, na.rm = TRUE)
min_costomolgas <- min(BD_pre_tratamiento$costomolgas, na.rm = TRUE)
max_costomolgas <- max(BD_pre_tratamiento$costomolgas, na.rm = TRUE)
# Cálculo dependencia y estandarización de variables
BD_0 <- BD_0 %>%
mutate(
dependencia = pmax(0,1 - (prod/consumo)),
est_costotransporte = (costotransporte - min_costotransporte) /
(max_costotransporte - min_costotransporte),
est_costomolgas = (costomolgas - min_costomolgas) /
(max_costomolgas - min_costomolgas)
)
# Cálculo de índice IVIG
## Ponderación inversa
# Promedio por departamento en el año 2023
datos_ref_depto <- BD_0 %>%
filter(year == 2023) %>%
group_by(departamento) %>%
summarise(
dependencia_mean = mean(dependencia, na.rm = TRUE),
est_costotransporte_mean = mean(est_costotransporte, na.rm = TRUE),
est_costomolgas_mean = mean(est_costomolgas, na.rm = TRUE)
) %>%
ungroup()
#Calcular varianzas entre departamentos
var_dependencia <- var(datos_ref_depto$dependencia_mean, na.rm = TRUE)
var_est_costotransporte <- var(datos_ref_depto$est_costotransporte_mean, na.rm = TRUE)
var_est_costomolgas <- var(datos_ref_depto$est_costomolgas_mean, na.rm = TRUE)
# Calcular ponderaciones de varianza inversa
inv_var_dependencia <- 1 / var_dependencia
inv_var_est_costotransporte <- 1 / var_est_costotransporte
inv_var_est_costomolgas <- 1 / var_est_costomolgas
sum_inv_vars <- inv_var_dependencia + inv_var_est_costotransporte + inv_var_est_costomolgas
w1_3 <- inv_var_dependencia / sum_inv_vars
w2_3 <- inv_var_est_costotransporte / sum_inv_vars
w3_3 <- inv_var_est_costomolgas / sum_inv_vars
# Cálculo de IVIG (continuo)
BD_0 <- BD_0 %>%
mutate(
IVIG_3_cont = (w1_3 * dependencia) + (w2_3 * est_costotransporte) + (w3_3 * est_costomolgas)
)
# Cálculo de IVIG (dicotoma)
# Calcular medianas en período pre-tratamiento (año 2023)
medianas_pre <- BD_0 %>%
filter(year == 2023) %>%
summarise(
mediana_IVIG_3 = median(IVIG_3_cont, na.rm = TRUE)
)
BD_0 <- BD_0 %>%
mutate(
IVIG_3_dt = ifelse(IVIG_3_cont >= medianas_pre$mediana_IVIG_3, 1, 0)
)
# Crear dataframe con los pesos
datos_pesos <- data.frame(
Variable = c("Dependencia", "Costo Transporte", "Costo Gas"),
Peso = c(w1_3, w2_3, w3_3)
)
# Gráfico de barras simple para los pesos
ggplot(datos_pesos, aes(x = Variable, y = Peso, fill = Variable)) +
geom_col(alpha = 0.7) +
labs(
title = "Figura 1: Ponderaciones del IVIG (Varianza Inversa)",
x = "",
y = "Peso") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
legend.position = "none",
axis.text.x = element_text(angle = 0, hjust = 0.5)) +
scale_y_continuous(labels = scales::percent)
ggsave("figura1_ponderaciones.png", width = 10, height = 6)
# Para ver las distribuciones de los componentes ponderados en la muestra
datos_componentes <- BD_0 %>%
filter(year == 2023) %>%
select(departamento, dependencia, est_costotransporte, est_costomolgas) %>%
mutate(
comp_dependencia = dependencia * w1_3,
comp_costotransporte = est_costotransporte * w2_3,
comp_costomolgas = est_costomolgas * w3_3
) %>%
select(departamento, starts_with("comp_")) %>%
pivot_longer(cols = starts_with("comp_"),
names_to = "Componente",
values_to = "Valor") %>%
mutate(Componente = case_when(
Componente == "comp_dependencia" ~ "Dependencia",
Componente == "comp_costotransporte" ~ "Costo Transporte",
Componente == "comp_costomolgas" ~ "Costo Gas"
))
# Boxplot de componentes ponderados
ggplot(datos_componentes, aes(x = Componente, y = Valor, fill = Componente)) +
geom_boxplot(alpha = 0.7) +
labs(
title = "Figura 2: Componentes Ponderados del IVIG (Varianza Inversa)",
subtitle = "Año 2023 (pre-tratamiento)",
x = "",
y = "Valor ponderado") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
legend.position = "none",
axis.text.x = element_text(angle = 0, hjust = 0.5))
ggsave("figura2_componentes.png", width = 10, height = 6)
# Clasificación de grupos tratados y control según el IVIG
BD_0 <- BD_0 %>%
mutate(
grupo_IVIG_3_label = ifelse(IVIG_3_dt == 1, "Tratado", "Control")
)
# Gráfico por departamento
ggplot(BD_0, aes(x = date, y = ind_prod_nominal, color = departamento)) +
geom_line(linewidth = 0.4) +
labs(title = "Figura 3: Índice de Producción Industrial Nominal por Departamento",
x = "Fecha",
y = "Índice de Producción Industrial Nominal",
color = "Departamento") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
axis.text.x = element_text(angle = 0, hjust = 1,size = 6),
axis.text.y = element_text (hjust = 1, size = 6),
legend.position = "right",
legend.text = element_text(size = 4))
ggsave("figura3_IPIND.png", width = 10, height = 6)
# Gráfico por industria
ggplot(BD_0, aes(x = date, y = ind_prod_nominal, color = industria)) +
geom_line(linewidth = 0.4) +
labs(title = "Figura 4: Índice de Producción Industrial Nominal por Industria",
x = "Fecha",
y = "Índice de Producción Industrial Nominal",
color = "Industria") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
axis.text.x = element_text(angle = 0, hjust = 1,size = 6),
axis.text.y = element_text (hjust = 1, size = 6),
legend.position = "right",
legend.text = element_text(size = 4))
ggsave("figura4_IPINI.png", width = 10, height = 6)
# Gráfico separados por departamento
ggplot(BD_0, aes(x = date, y = ind_prod_nominal)) +
geom_line(color = "steelblue", linewidth = 0.4) +
facet_wrap(~departamento, scales = "free_y") +
labs(title = "Figura 5: Índice de Producción Industrial Nominal por Departamento",
x = "Fecha",
y = "Índice") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1,size = 6),
axis.text.y = element_text (hjust = 1, size = 6),
strip.text = element_text(size = 4))
ggsave("figura5_IPIND2.png", width = 10, height = 6)
# Gráfico separados separados por industria
ggplot(BD_0, aes(x = date, y = ind_prod_nominal)) +
geom_line(color = "darkgreen", linewidth = 0.4) +
facet_wrap(~industria, scales = "free_y") +
labs(title = "Figura 6: Índice de Producción Industrial Nominal por Industria",
x = "Fecha",
y = "Índice") +
theme_minimal() +
theme(plot.title = element_text(size = 14, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1,size = 6),
axis.text.y = element_text (hjust = 1, size = 6),
strip.text = element_text(size = 5))
ggsave("figura6_IPINI2.png", width = 10, height = 6)
BD_0 <- BD_0 %>%
mutate(date = as.Date(date))
# Verificar que ahora es Date
cat("Clase de 'date' después de conversión:", class(BD_0$date), "\n")
# Función para crear gráfico de tendencias paralelas
plot_tendencias <- function(data, grupo_var, titulo, fecha_shock,
periodo_pre_inicio = NULL) {
# Si no se especifica inicio del período pre, usar toda la data antes del shock
if(is.null(periodo_pre_inicio)) {
periodo_pre_inicio <- min(data$date, na.rm = TRUE)
}
# Preparar datos agregados por fecha y grupo
datos_plot <- data %>%
group_by(date, !!sym(grupo_var)) %>%
summarise(
prod_mean = mean(ind_prod_nominal, na.rm = TRUE),
prod_se = sd(ind_prod_nominal, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
) %>%
mutate(
periodo = ifelse(date < fecha_shock, "Pre-shock", "Post-shock")
)
# Crear gráfico
p <- ggplot(datos_plot, aes(x = date, y = prod_mean,
color = !!sym(grupo_var),
linetype = periodo)) +
geom_line(linewidth = 1) +
geom_ribbon(aes(ymin = prod_mean - 1.96*prod_se,
ymax = prod_mean + 1.96*prod_se,
fill = !!sym(grupo_var)),
alpha = 0.2, color = NA) +
geom_vline(xintercept = fecha_shock,
linetype = "dashed", color = "red", linewidth = 1) +
annotate("text", x = fecha_shock, y = max(datos_plot$prod_mean, na.rm=TRUE),
label = "Shock", color = "red", hjust = -0.1, size = 4) +
labs(title = titulo,
subtitle = paste("Línea vertical roja:", format(fecha_shock, "%b %Y")),
x = "Fecha",
y = "Productividad Industrial Nominal (promedio)",
color = "Grupo",
fill = "Grupo",
linetype = "Período") +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
legend.position = "bottom",
panel.grid.minor = element_blank()
) +
scale_color_manual(values = c("Control" = "#0072B2",
"Tratado" = "#D55E00")) +
scale_fill_manual(values = c("Control" = "#0072B2",
"Tratado" = "#D55E00"))
ggsave("figura7_PIN_lineas.png", width = 10, height = 6)
return(p)
}
