summarise(
Media = mean(IVIG, na.rm = TRUE),
Mediana = median(IVIG, na.rm = TRUE),
SD = sd(IVIG, na.rm = TRUE),
Min = min(IVIG, na.rm = TRUE),
Max = max(IVIG, na.rm = TRUE),
N_alta_vuln = sum(IVIG >= median(IVIG, na.rm = TRUE))
)
