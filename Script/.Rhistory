# Crear shock placebo 12 meses antes del verdadero
fecha_placebo <- fecha_pre_tratamiento %m-% months(12)
BD_placebo <- BD_0 %>%
filter(date < fecha_pre_tratamiento) %>%  # Solo período pre-tratamiento real
mutate(Shock_Placebo = ifelse(date >= fecha_placebo, 1, 0))
modelo_placebo <- feols(
costomolgas ~ Shock_Placebo:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) + ind_prod_nominal +
log (PIB_DPTO)|
departamento + ym_2,
data = BD_placebo,
cluster = ~departamento
)
cat("✓ Placebo test estimado\n")
# ESTIMACION DiD - SHOCK IMPORTACIÓN (dic 2024)
cat("Modelo Diferencias en Diferencias\n")
# Enumerar la tabla
numero_tabla <- 11
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
cat("→ Variable Shock_Importacion creada\n")
}
modelo_imp_m1 <- feols(
costomolgas ~ Shock_Importacion + Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura +
log(poblacion) + log(SGP) + ind_prod_nominal + log (PIB_DPTO)
|departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelos Importación estimados\n")
# Resultado del modelo de DiD
etable(modelo_imp_m1,
tex = TRUE,
title = "Efecto de la Importación de Gas (GNI) sobre Costo Molelcula de Gas",
headers = c("Importación"),
drop = "ind_prod_nominal|PIB_DPTO|cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = NULL,
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1,
file = file.path(dir_tablas,"tabla_temp.tex")
)
#Convertir la tabla de resultados en Latex y PNG.
# Leer el contenido de la tabla
tabla_contenido <- readLines(file.path(dir_tablas,"tabla_temp.tex"))
# Extraer SOLO el contenido entre \begin{document} y \end{document}
inicio <- which(grepl("\\\\begin\\{document\\}", tabla_contenido))
fin <- which(grepl("\\\\end\\{document\\}", tabla_contenido))
if (length(inicio) > 0 && length(fin) > 0) {
# Extraer solo el contenido de la tabla (sin document tags)
tabla_limpia <- tabla_contenido[(inicio + 1):(fin - 1)]
} else {
# Si no hay \begin{document}, usar todo el contenido
tabla_limpia <- tabla_contenido
}
# Remover \begin{table} y \end{table} duplicados si existen
tabla_limpia <- tabla_limpia[!grepl("^\\\\begin\\{table\\}|^\\\\end\\{table\\}|^\\\\centering$", tabla_limpia)]
# Crear documento completo con notas alineadas
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{caption}",
"\\usepackage{threeparttable}",
"\\usepackage{dcolumn}",
"\\usepackage{adjustbox}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=0.5in, paperwidth=14in, paperheight=10in]{geometry}",
"\\pagestyle{empty}",
"\\begin{document}",
paste0("\\setcounter{table}{", numero_tabla - 1, "}"),
"\\begin{table}[htbp]",
"\\centering",
"\\begin{threeparttable}",
tabla_limpia,
"\\begin{tablenotes}",
"\\footnotesize",
"\\item \\textit{Notas:} Errores estándar agrupados a nivel departamental entre paréntesis.",
"\\end{tablenotes}",
"\\end{threeparttable}",
"\\end{table}",
"\\end{document}"
)
# Guardar UN SOLO archivo .tex
writeLines(doc_completo, file.path(dir_tablas,"modelo_did.tex"))
cat("✓ Archivo .tex guardado\n")
# Compilar
dir_actual <- getwd()
setwd(dir_tablas)
resultado <- try({
tinytex::pdflatex("modelo_did.tex")
}, silent = FALSE)
setwd(dir_actual)
if (inherits(resultado, "try-error")) {
cat("\n❌ Error al compilar. Mostrando las últimas líneas del log:\n")
log_file <- file.path(dir_tablas, "modelo_did.log")
if (file.exists(log_file)) {
log_lines <- readLines(log_file)
cat(tail(log_lines, 30), sep = "\n")
}
stop("No se pudo compilar el documento LaTeX")
}
# Verificar la ruta correcta del PDF
pdf_path <- file.path(dir_tablas, "modelo_did.pdf")
if (file.exists(pdf_path)) {
# Convertir a PNG
img <- image_read_pdf(pdf_path, density = 300)
image_write(img, file.path(dir_tablas, "modelo_did.png"))
cat("✓ Tabla convertida a PNG:", file.path(dir_tablas, "modelo_did.png"), "\n")
# Limpiar archivos temporales
archivos_temp <- c(
file.path(dir_tablas, "tabla_temp.tex"),
file.path(dir_tablas, "modelo_did.pdf"),
file.path(dir_tablas, "modelo_did.aux"),
file.path(dir_tablas, "modelo_did.log")
)
file.remove(archivos_temp[file.exists(archivos_temp)])
cat("✓ Archivos temporales eliminados\n")
} else {
cat("❌ No se generó el PDF\n")
cat("Ruta buscada:", pdf_path, "\n")
# Verificar qué archivos se crearon
cat("Archivos en", dir_tablas, ":\n")
print(list.files(dir_tablas))
}
