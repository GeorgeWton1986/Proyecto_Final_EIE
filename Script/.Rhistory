cat("✓ Archivos temporales eliminados\n")
} else {
cat("❌ No se generó el PDF\n")
}
cat("ANÁLISIS DE ROBUSTEZ\n")
# 1. ESPECIFICACIÓN ALTERNATIVA: Sin controles
cat("1. Modelo sin controles (solo efectos fijos)...\n")
modelo_rob_sincontroles <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo sin controles estimado\n\n")
# 2. ESPECIFICACIÓN ALTERNATIVA: Umbral alternativo (percentil 75)
cat("2. Modelo con umbral alternativo (P75)...\n")
# Calcular percentil 75 en período pre-tratamiento
p75_pre <- BD_0 %>%
filter(year == 2023) %>%
summarise(p75 = quantile(IVIG_3_cont, 0.75, na.rm = TRUE)) %>%
pull(p75)
BD_0 <- BD_0 %>%
mutate(IVIG_3_dt_p75 = ifelse(IVIG_3_cont >= p75_pre, 1, 0))
modelo_rob_p75 <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt_p75 + IVIG_3_dt_p75 +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con P75 estimado\n\n")
# 3. ESPECIFICACIÓN ALTERNATIVA: Efectos fijos más estrictos
cat("3. Modelo con efectos fijos departamento × año...\n")
BD_0 <- BD_0 %>%
mutate(depto_year = paste(departamento, year, sep = "_"))
modelo_rob_fe_estricto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
depto_year + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con FE estrictos estimado\n\n")
# 4. PLACEBO TEST: Shock falso 12 meses antes
cat("4. Placebo test (shock falso)...\n")
# Crear shock placebo 12 meses antes del verdadero
fecha_placebo <- fecha_pre_tratamiento %m-% months(12)
BD_placebo <- BD_0 %>%
filter(date < fecha_pre_tratamiento) %>%  # Solo período pre-tratamiento real
mutate(Shock_Placebo = ifelse(date >= fecha_placebo, 1, 0))
modelo_placebo <- feols(
ind_prod_nominal ~ Shock_Placebo:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_placebo,
cluster = ~departamento
)
cat("✓ Placebo test estimado\n\n")
# ESTIMACION DiD - SHOCK IMPORTACIÓN (dic 2024)
cat("Estimando modelos con Shock Importación...\n")
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
cat("→ Variable Shock_Importacion creada\n")
}
modelo_imp_m1 <- feols(
ind_prod_nominal ~ Shock_Importacion + Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura +
log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelos Importación estimados\n\n")
etable(modelo_imp_m1,
tex = TRUE,
title = "Efecto de la Importación de Gas (GNI) sobre Productividad Industrial",
headers = c("Importación"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = NULL,
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1,
file = "Tablas/tabla_temp.tex"
)
# Crear directorio
if (!dir.exists("Tablas")) dir.create("Tablas")
cat("✓ Tabla LaTeX generada\n\n")
# Leer el contenido de la tabla
tabla_contenido <- readLines("Tablas/tabla_temp.tex")
# Extraer SOLO el contenido entre \begin{document} y \end{document}
inicio <- which(grepl("\\\\begin\\{document\\}", tabla_contenido))
fin <- which(grepl("\\\\end\\{document\\}", tabla_contenido))
if (length(inicio) > 0 && length(fin) > 0) {
# Extraer solo el contenido de la tabla (sin document tags)
tabla_limpia <- tabla_contenido[(inicio + 1):(fin - 1)]
} else {
# Si no hay \begin{document}, usar todo el contenido
tabla_limpia <- tabla_contenido
}
# Remover \begin{table} y \end{table} duplicados si existen
tabla_limpia <- tabla_limpia[!grepl("^\\\\begin\\{table\\}|^\\\\end\\{table\\}|^\\\\centering$", tabla_limpia)]
# Crear documento completo con notas alineadas
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{caption}",
"\\usepackage{threeparttable}",
"\\usepackage{dcolumn}",
"\\usepackage{adjustbox}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=0.5in, paperwidth=14in, paperheight=10in]{geometry}",
"\\pagestyle{empty}",
"\\begin{document}",
"\\begin{table}[htbp]",
"\\centering",
"\\begin{threeparttable}",
tabla_limpia,
"\\begin{tablenotes}",
"\\footnotesize",
"\\item \\textit{Notas:} Estación de ponderación por Varianza inversa - Errores estándar agrupados por departamento en paréntesis.",
"\\end{tablenotes}",
"\\end{threeparttable}",
"\\end{table}",
"\\end{document}"
)
# Guardar UN SOLO archivo .tex
writeLines(doc_completo, "Tablas/mod_did.tex")
cat("✓ Archivo .tex guardado\n")
# Compilar
dir_actual <- getwd()
setwd("Tablas")
resultado <- try({
tinytex::pdflatex("mod_did.tex")
}, silent = FALSE)
if (inherits(resultado, "try-error")) {
cat("\n❌ Error al compilar. Mostrando las últimas líneas del log:\n\n")
if (file.exists("mod_did.log")) {
log_lines <- readLines("mod_did.log")
cat(tail(log_lines, 30), sep = "\n")
}
setwd(dir_actual)
stop("No se pudo compilar el documento LaTeX")
}
setwd(dir_actual)
# Convertir a PNG
if (file.exists("Tablas/mod_did.pdf")) {
img <- image_read_pdf("Tablas/mod_did.pdf", density = 300)
image_write(img, "Tablas/mod_did.png")
cat("✓ Tabla convertida a PNG: Tablas/mod_did.png\n")
# Limpiar archivos temporales
archivos_temp <- c("Tablas/tabla_temp.tex",
"Tablas/mod_did.pdf",
"Tablas/mod_did.aux",
"Tablas/mod_did.log")
file.remove(archivos_temp[file.exists(archivos_temp)])
cat("✓ Archivos temporales eliminados\n")
} else {
cat("❌ No se generó el PDF\n")
}
# 3. HETEROGENEIDAD POR DEPARTAMENTO ESPECÍFICO
cat("\n3. Estimando efectos por departamento\n")
# Modelo con interacciones departamento × shock
modelo_het_depto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:departamento +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por departamento estimado\n\n")
etable(modelo_het_depto,
tex = TRUE,
title = "Heterogeneidad por departamento",
headers = c("Modelo Heterogéneo por Departamento"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = NULL,
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1,
file = "Tablas/tabla_temp.tex"
)
# Crear directorio
