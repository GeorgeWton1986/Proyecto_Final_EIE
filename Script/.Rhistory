# Extraer coeficientes de departamentos
coefs_depto <- coef(modelo_het_depto)
nombres_depto <- names(coefs_depto)[grepl("departamento", names(coefs_depto))]
valores_depto <- coefs_depto[nombres_depto]
# Limpiar nombres
nombres_limpios <- gsub("Shock_Importacion:IVIG_3_dt:departamento", "", nombres_depto)
# Crear dataframe
df_plot <- data.frame(
departamento = nombres_limpios,
coef = valores_depto,
se = se(modelo_het_depto)[nombres_depto]
) %>%
mutate(
ci_low = coef - 1.96 * se,
ci_high = coef + 1.96 * se,
significativo = ifelse(ci_low > 0 | ci_high < 0, "Sí", "No")
)
# Gráfico
ggplot(df_plot, aes(x = reorder(departamento, coef), y = coef)) +
geom_point(aes(color = significativo), size = 3) +
geom_errorbar(aes(ymin = ci_low, ymax = ci_high, color = significativo),
width = 0.2, linewidth = 1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
coord_flip() +
labs(title = "Figura 12: Efectos Heterogéneos por Departamento",
subtitle = "Shock Importación × Vulnerabilidad (con IC 95%)",
x = "Departamento",
y = "Efecto estimado",
color = "Significativo (5%)") +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
axis.title = element_text(size = 11),
legend.position = "bottom",
panel.grid.minor = element_blank()
)+
scale_color_manual(values = c("No" = "gray", "Sí" = "red"))
ggsave(file.path(dir_graficos,"figura12_efect_hetero_dpto.png"), width = 10, height = 6)
cat("ANÁLISIS DE ROBUSTEZ\n")
# 1. ESPECIFICACIÓN ALTERNATIVA: Sin controles
cat("1. Modelo sin controles (solo efectos fijos)...\n")
modelo_rob_sincontroles <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo sin controles estimado\n")
# 2. ESPECIFICACIÓN ALTERNATIVA: Umbral alternativo (percentil 75)
cat("2. Modelo con umbral alternativo (P75)...\n")
# Calcular percentil 75 en período pre-tratamiento
p75_pre <- BD_0 %>%
filter(year == 2023) %>%
summarise(p75 = quantile(IVIG_3_cont, 0.75, na.rm = TRUE)) %>%
pull(p75)
BD_0 <- BD_0 %>%
mutate(IVIG_3_dt_p75 = ifelse(IVIG_3_cont >= p75_pre, 1, 0))
modelo_rob_p75 <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt_p75 + IVIG_3_dt_p75 +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con P75 estimado\n")
# 3. ESPECIFICACIÓN ALTERNATIVA: Efectos fijos más estrictos
cat("3. Modelo con efectos fijos departamento × año...\n")
BD_0 <- BD_0 %>%
mutate(depto_year = paste(departamento, year, sep = "_"))
modelo_rob_fe_estricto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
depto_year + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con FE estrictos estimado\n")
# 4. PLACEBO TEST: Shock falso 12 meses antes
cat("4. Placebo test (shock falso)...\n")
# Crear shock placebo 12 meses antes del verdadero
fecha_placebo <- fecha_pre_tratamiento %m-% months(12)
BD_placebo <- BD_0 %>%
filter(date < fecha_pre_tratamiento) %>%  # Solo período pre-tratamiento real
mutate(Shock_Placebo = ifelse(date >= fecha_placebo, 1, 0))
modelo_placebo <- feols(
ind_prod_nominal ~ Shock_Placebo:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_placebo,
cluster = ~departamento
)
cat("✓ Placebo test estimado\n")
# ESTIMACION DiD - SHOCK IMPORTACIÓN (dic 2024)
cat("Modelo Diferencias en Diferencias\n")
# Enumerar la tabla
numero_tabla <- 9
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
cat("→ Variable Shock_Importacion creada\n")
}
modelo_imp_m1 <- feols(
ind_prod_nominal ~ Shock_Importacion + Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura +
log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelos Importación estimados\n")
# Resultado del modelo de DiD
