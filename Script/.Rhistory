"Madera y muebles",
"Minerales no metálicos",
"Papel e imprentas",
"Productos metálicos",
"Sustancias y productos químicos, farmacéuticos, de caucho y plástico",
"Textiles, confecciones y cuero"))
)
# Verificar que "Total" es ahora la referencia
cat("Nuevo orden de niveles (la referencia es el primero):\n")
print(levels(BD_0$industria))
cat("\n")
# Modelo con triple interacción: Shock × Grupo × Industria
modelo_het_industria <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:industria +
Shock_Importacion:IVIG_3_dt +
Shock_Importacion:industria +
IVIG_3_dt:industria +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por industria estimado\n")
# 1. HETEROGENEIDAD POR INDUSTRIA
cat("1. Estimando efectos por industria\n")
# Enumerar la tabla
numero_tabla <- 6
# Crear variable de shock
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
}
# Cambiar el nivel de referencia del factor
BD_0 <- BD_0 %>%
mutate(
industria = factor(industria,
levels = c("Total",
"Alimentos y bebidas",
"Madera y muebles",
"Minerales no metálicos",
"Papel e imprentas",
"Productos metálicos",
"Sustancias y productos químicos, farmacéuticos, de caucho y plástico",
"Textiles, confecciones y cuero"))
)
# Verificar que "Total" es ahora la referencia
cat("Nuevo orden de niveles (la referencia es el primero):\n")
print(levels(BD_0$industria))
cat("\n")
# Modelo con triple interacción: Shock × Grupo × Industria
modelo_het_industria <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:industria +
Shock_Importacion:IVIG_3_dt +
Shock_Importacion:industria +
IVIG_3_dt:industria +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por industria estimado\n")
# Resultado del modelo de Heterogeneidad por Industria
etable(modelo_het_industria,
tex = TRUE,
title = "Heterogeneidad por Industria",
headers = c("Modelo Heterogéneo por Industria"),
keep = "%Shock_Importacion:IVIG_3_dt:industria",
notes = NULL,
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1,
file = file.path(dir_tablas,"tabla_temp.tex")
)
#Convertir la tabla de resultados en Latex y PNG.
# Leer el contenido de la tabla
tabla_contenido <- readLines(file.path(dir_tablas,"tabla_temp.tex"))
# Extraer SOLO el contenido entre \begin{document} y \end{document}
inicio <- which(grepl("\\\\begin\\{document\\}", tabla_contenido))
fin <- which(grepl("\\\\end\\{document\\}", tabla_contenido))
if (length(inicio) > 0 && length(fin) > 0) {
# Extraer solo el contenido de la tabla (sin document tags)
tabla_limpia <- tabla_contenido[(inicio + 1):(fin - 1)]
} else {
# Si no hay \begin{document}, usar todo el contenido
tabla_limpia <- tabla_contenido
}
# Remover \begin{table} y \end{table} duplicados si existen
tabla_limpia <- tabla_limpia[!grepl("^\\\\begin\\{table\\}|^\\\\end\\{table\\}|^\\\\centering$", tabla_limpia)]
# Crear documento completo con notas alineadas
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{caption}",
"\\usepackage{threeparttable}",
"\\usepackage{dcolumn}",
"\\usepackage{adjustbox}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=0.5in, paperwidth=14in, paperheight=10in]{geometry}",
"\\pagestyle{empty}",
"\\begin{document}",
paste0("\\setcounter{table}{", numero_tabla - 1, "}"),
"\\begin{table}[htbp]",
"\\centering",
"\\begin{threeparttable}",
tabla_limpia,
"\\begin{tablenotes}",
"\\footnotesize",
"\\item \\textit{Notas:} Errores estándar agrupados a nivel departamental entre paréntesis, Todos los coeficientes se interpretan relativo a la industria de referencia que sera el total agregado",
"\\end{tablenotes}",
"\\end{threeparttable}",
"\\end{table}",
"\\end{document}"
)
# Guardar UN SOLO archivo .tex
writeLines(doc_completo, file.path(dir_tablas,"hetero_industria.tex"))
cat("✓ Archivo .tex guardado\n")
# Compilar
dir_actual <- getwd()
setwd(dir_tablas)
resultado <- try({
tinytex::pdflatex("hetero_industria.tex")
}, silent = FALSE)
setwd(dir_actual)
if (inherits(resultado, "try-error")) {
cat("\n❌ Error al compilar. Mostrando las últimas líneas del log:\n")
log_file <- file.path(dir_tablas, "hetero_industria.log")
if (file.exists(log_file)) {
log_lines <- readLines(log_file)
cat(tail(log_lines, 30), sep = "\n")
}
stop("No se pudo compilar el documento LaTeX")
}
# Verificar la ruta correcta del PDF
pdf_path <- file.path(dir_tablas, "hetero_industria.pdf")
if (file.exists(pdf_path)) {
# Convertir a PNG
img <- image_read_pdf(pdf_path, density = 300)
image_write(img, file.path(dir_tablas, "hetero_industria.png"))
cat("✓ Tabla convertida a PNG:", file.path(dir_tablas, "hetero_industria.png"), "\n")
# Limpiar archivos temporales
archivos_temp <- c(
file.path(dir_tablas, "tabla_temp.tex"),
file.path(dir_tablas, "hetero_industria.pdf"),
file.path(dir_tablas, "hetero_industria.aux"),
file.path(dir_tablas, "hetero_industria.log")
)
file.remove(archivos_temp[file.exists(archivos_temp)])
cat("✓ Archivos temporales eliminados\n")
} else {
cat("❌ No se generó el PDF\n")
cat("Ruta buscada:", pdf_path, "\n")
# Verificar qué archivos se crearon
cat("Archivos en", dir_tablas, ":\n")
print(list.files(dir_tablas))
}
modelo_cuadratico <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_cont +
Shock_Importacion:I(IVIG_3_cont^2) +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
# Ver distribución del IVIG
summary(BD_0$IVIG_3_cont)
BD_0 %>%
group_by(IVIG_3_dt) %>%
summarise(
IVIG_min = min(IVIG_3_cont, na.rm = TRUE),
IVIG_mean = mean(IVIG_3_cont, na.rm = TRUE),
IVIG_max = max(IVIG_3_cont, na.rm = TRUE)
)
# Crear predicciones para diferentes niveles de IVIG
ivig_seq <- seq(min(BD_0$IVIG_3_cont, na.rm = TRUE),
max(BD_0$IVIG_3_cont, na.rm = TRUE),
length.out = 100)
efecto_pred <- 24.82 * ivig_seq
se_pred <- 11.55 * ivig_seq
df_pred <- data.frame(
IVIG = ivig_seq,
Efecto = efecto_pred,
IC_low = efecto_pred - 1.96 * se_pred,
IC_high = efecto_pred + 1.96 * se_pred
)
ggplot(df_pred, aes(x = IVIG, y = Efecto)) +
geom_line(color = "steelblue", linewidth = 1) +
geom_ribbon(aes(ymin = IC_low, ymax = IC_high),
alpha = 0.2, fill = "steelblue") +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
labs(title = "Efecto del Shock según Nivel de Vulnerabilidad (IVIG)",
subtitle = "Modelo lineal con IC 95%",
x = "Índice de Vulnerabilidad (IVIG continuo)",
y = "Efecto en Productividad Industrial") +
theme_minimal()
View(modelo_cuadratico)
View(modelo_cuadratico)
etable(modelo_cuadratico,
tex = TRUE,
title = "Efecto según Nivel de Vulnerabilidad (IVIG continuo)",
headers = c("IVIG Continuo"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = NULL,
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1)
# ============================================================
# VERIFICAR HIPÓTESIS: ¿Departamentos vulnerables = Prósperos?
# ============================================================
cat("\n============================================================\n")
cat("ANÁLISIS: Relación entre Vulnerabilidad y Prosperidad\n")
cat("============================================================\n\n")
# Calcular promedios por departamento en período pre-shock (2023)
analisis_deptos <- BD_0 %>%
filter(year == 2023) %>%
group_by(departamento) %>%
summarise(
# Vulnerabilidad
IVIG_mean = mean(IVIG_3_cont, na.rm = TRUE),
grupo_vulnerable = first(IVIG_3_dt),
# Indicadores de prosperidad
prod_ind_mean = mean(ind_prod_nominal, na.rm = TRUE),
pib_mean = mean(pib, na.rm = TRUE),
poblacion_mean = mean(poblacion, na.rm = TRUE),
sgp_mean = mean(SGP, na.rm = TRUE),
# Componentes del IVIG
dependencia_mean = mean(dependencia, na.rm = TRUE),
costotransporte_mean = mean(costotransporte, na.rm = TRUE),
costomolgas_mean = mean(costomolgas, na.rm = TRUE)
) %>%
ungroup() %>%
mutate(
grupo_label = ifelse(grupo_vulnerable == 1, "Vulnerable", "Control")
)
# Calcular promedios por departamento en período pre-shock (2023)
analisis_deptos <- BD_0 %>%
filter(year == 2023) %>%
group_by(departamento) %>%
summarise(
# Vulnerabilidad
IVIG_mean = mean(IVIG_3_cont, na.rm = TRUE),
grupo_vulnerable = first(IVIG_3_dt),
# Indicadores de prosperidad
prod_ind_mean = mean(ind_prod_nominal, na.rm = TRUE),
pib_mean = mean(pib, na.rm = TRUE),
poblacion_mean = mean(poblacion, na.rm = TRUE),
sgp_mean = mean(SGP, na.rm = TRUE),
# Componentes del IVIG
dependencia_mean = mean(dependencia, na.rm = TRUE),
costotransporte_mean = mean(costotransporte, na.rm = TRUE),
costomolgas_mean = mean(costomolgas, na.rm = TRUE)
) %>%
ungroup() %>%
mutate(
grupo_label = ifelse(grupo_vulnerable == 1, "Vulnerable", "Control")
)
# Calcular promedios por departamento en período pre-shock (2023)
analisis_deptos <- BD_0 %>%
filter(year == 2023) %>%
group_by(departamento) %>%
summarise(
# Vulnerabilidad
IVIG_mean = mean(IVIG_3_cont, na.rm = TRUE),
grupo_vulnerable = first(IVIG_3_dt),
# Indicadores de prosperidad
prod_ind_mean = mean(ind_prod_nominal, na.rm = TRUE),
pib_mean = mean(PIB_DPTO, na.rm = TRUE),
poblacion_mean = mean(poblacion, na.rm = TRUE),
sgp_mean = mean(SGP, na.rm = TRUE),
# Componentes del IVIG
dependencia_mean = mean(dependencia, na.rm = TRUE),
costotransporte_mean = mean(costotransporte, na.rm = TRUE),
costomolgas_mean = mean(costomolgas, na.rm = TRUE)
) %>%
ungroup() %>%
mutate(
grupo_label = ifelse(grupo_vulnerable == 1, "Vulnerable", "Control")
)
# 1. TABLA DESCRIPTIVA
cat("Tabla 1: Características por Grupo de Vulnerabilidad\n")
cat("======================================================\n\n")
comparacion_grupos <- analisis_deptos %>%
group_by(grupo_label) %>%
summarise(
N_deptos = n(),
IVIG_promedio = mean(IVIG_mean, na.rm = TRUE),
Productividad = mean(prod_ind_mean, na.rm = TRUE),
PIB_promedio = mean(pib_mean, na.rm = TRUE),
Poblacion = mean(poblacion_mean, na.rm = TRUE),
SGP = mean(sgp_mean, na.rm = TRUE)
)
kable(comparacion_grupos,
format = "simple",
digits = 2,
col.names = c("Grupo", "N deptos", "IVIG", "Productividad",
"PIB", "Población", "SGP"))
# 2. CORRELACIONES
cat("\n\nTabla 2: Correlaciones entre IVIG y Variables de Prosperidad\n")
cat("=============================================================\n\n")
correlaciones <- analisis_deptos %>%
summarise(
`IVIG vs PIB` = cor(IVIG_mean, pib_mean, use = "complete.obs"),
`IVIG vs Productividad` = cor(IVIG_mean, prod_ind_mean, use = "complete.obs"),
`IVIG vs Población` = cor(IVIG_mean, poblacion_mean, use = "complete.obs"),
`IVIG vs SGP` = cor(IVIG_mean, sgp_mean, use = "complete.obs")
) %>%
pivot_longer(cols = everything(),
names_to = "Correlación",
values_to = "Valor")
kable(correlaciones,
format = "simple",
digits = 3)
# 5. TEST ESTADÍSTICO
cat("\n\nTest t: ¿Los grupos difieren en PIB?\n")
cat("=====================================\n")
test_pib <- t.test(pib_mean ~ grupo_label, data = analisis_deptos)
print(test_pib)
cat("\n\nTest t: ¿Los grupos difieren en Productividad?\n")
cat("===============================================\n")
test_prod <- t.test(prod_ind_mean ~ grupo_label, data = analisis_deptos)
print(test_prod)
# 6. TABLA FINAL: Ranking departamentos
cat("\n\nTabla 3: Ranking de Departamentos (por IVIG)\n")
cat("=============================================\n\n")
ranking <- analisis_deptos %>%
select(departamento, IVIG_mean, grupo_label, prod_ind_mean, pib_mean) %>%
arrange(desc(IVIG_mean))
kable(ranking,
format = "simple",
digits = 3,
col.names = c("Departamento", "IVIG", "Grupo", "Productividad", "PIB"))
