format = "latex",
booktabs = TRUE,
caption = "Primeros 5 registros de la base de datos",
digits = 2,
escape = TRUE)
# Guardar la tabla en un archivo
writeLines(as.character(tabla_latex_1), file.path(dir_tablas, "tabla_temp.tex"))
#Convertir la tabla de resultados en Latex y PNG.
