BD_0 <- BD_0 %>%
mutate(date = as.Date(date))
# Verificar que ahora es Date
cat("Clase de 'date' después de conversión:", class(BD_0$date), "\n")
# Función para crear gráfico de tendencias paralelas
plot_tendencias <- function(data, grupo_var, titulo, fecha_shock,
periodo_pre_inicio = NULL) {
# Si no se especifica inicio del período pre, usar toda la data antes del shock
if(is.null(periodo_pre_inicio)) {
periodo_pre_inicio <- min(data$date, na.rm = TRUE)
}
# Preparar datos agregados por fecha y grupo
datos_plot <- data %>%
group_by(date, !!sym(grupo_var)) %>%
summarise(
prod_mean = mean(ind_prod_nominal, na.rm = TRUE),
prod_se = sd(ind_prod_nominal, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
) %>%
mutate(
periodo = ifelse(date < fecha_shock, "Pre-shock", "Post-shock")
)
# Crear gráfico
p <- ggplot(datos_plot, aes(x = date, y = prod_mean,
color = !!sym(grupo_var),
linetype = periodo)) +
geom_line(linewidth = 1) +
geom_ribbon(aes(ymin = prod_mean - 1.96*prod_se,
ymax = prod_mean + 1.96*prod_se,
fill = !!sym(grupo_var)),
alpha = 0.2, color = NA) +
geom_vline(xintercept = fecha_shock,
linetype = "dashed", color = "red", linewidth = 1) +
annotate("text", x = fecha_shock, y = max(datos_plot$prod_mean, na.rm=TRUE),
label = "Shock", color = "red", hjust = -0.1, size = 4) +
labs(title = titulo,
subtitle = paste("Línea vertical roja:", format(fecha_shock, "%b %Y")),
x = "Fecha",
y = "Productividad Industrial Nominal (promedio)",
color = "Grupo",
fill = "Grupo",
linetype = "Período") +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
legend.position = "bottom",
panel.grid.minor = element_blank()
) +
scale_color_manual(values = c("Control" = "#0072B2",
"Tratado" = "#D55E00")) +  # ✅ CORREGIDO: "Tratado" en lugar de "Tratamiento"
scale_fill_manual(values = c("Control" = "#0072B2",
"Tratado" = "#D55E00"))
return(p)
}
# Importación GNI (dic 2024)
p3_imp <- plot_tendencias(BD_0, "grupo_IVIG_3_label",
"Productividad Industrial Nominal - Método 3 Importación GNI",
fecha_pre_tratamiento)
print(p3_imp)
# Gráfica de estudio de evento
# Crear la variable de tiempo relativo al shock
# Shock Importación (dic 2024)
BD_0 <- BD_0 %>%
mutate(
tiempo_rel_imp = interval(fecha_pre_tratamiento, date) %/% months(1),
periodo_imp = as.integer(tiempo_rel_imp)
)
# Verificar distribución por los shocks
cat("Rango de períodos Importación:",
range(BD_0$periodo_imp, na.rm = TRUE), "\n\n")
# Seleccionar los rangos de periodos
# Definir ventana de análisis (ej: -24 a +24 meses)
ventana_imp <- c(-12, 5)       # 6 meses antes, 6 meses después
BD_event_imp <- BD_0 %>%
filter(periodo_imp >= ventana_imp[1] &
periodo_imp <= ventana_imp[2])
cat("Observaciones para Event Study Importación:", nrow(BD_event_imp), "\n\n")
#Modelo con interacción periodo y grupo
cat("Estimando modelos Event Study...\n\n")
# EVENT STUDY - SHOCK IMPORTACIÓN
modelo_event_imp <- feols(ind_prod_nominal ~ i(periodo_imp, IVIG_3_dt, ref = -1) +
cobertura +
log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_event_imp,
cluster = ~departamento
)
etable(modelo_event_imp,
digits = 4,
se = "cluster",
cluster = "departamento",
title = "Modelos Event Study - Importación GNI",
depvar = FALSE
)
cat("✓ Modelos Event Study estimados\n\n")
# Extraer coeficientes
# Función para extraer coeficientes del event study
extraer_coefs_event <- function(modelo, nombre_var) {
# Obtener todos los coeficientes
coefs <- coef(modelo)
ses <- se(modelo)
# Filtrar solo los de interacción (nombres contienen el período)
indices <- grep(nombre_var, names(coefs))
# Extraer períodos de los nombres
# Ejemplo: "periodo_covid::-12:grupo_IVIG_3" → -12
periodos <- as.numeric(gsub(".*::([-]?[0-9]+):.*", "\\1", names(coefs)[indices]))
# Crear data frame
df <- data.frame(
periodo = periodos,
coef = coefs[indices],
se = ses[indices]
) %>%
mutate(
ci_low = coef - 2.56 * se,
ci_high = coef + 2.56 * se
) %>%
arrange(periodo)
# Agregar período de referencia (-1) con coef = 0
df_ref <- data.frame(
periodo = -1,
coef = 0,
se = 0,
ci_low = 0,
ci_high = 0
)
df <- bind_rows(df, df_ref) %>%
arrange(periodo)
return(df)
}
# Extraer coeficientes
coefs_imp <- extraer_coefs_event(modelo_event_imp, "periodo_imp")
cat("Coeficientes extraídos:\n")
cat("  Importación: N períodos =", nrow(coefs_imp), "\n\n")
# Gerenerar el gráfico de Evento
cat("Generando gráficos...\n\n")
# FUNCIÓN PARA GRAFICAR
plot_event_study <- function(coefs_df, titulo, fecha_shock_label) {
# Identificar período pre/post
coefs_df <- coefs_df %>%
mutate(
fase = ifelse(periodo < 0, "Pre-shock", "Post-shock"),
significativo = ifelse(ci_low > 0 | ci_high < 0, "Sí", "No")
)
p <- ggplot(coefs_df, aes(x = periodo, y = coef)) +
# Banda de confianza
geom_ribbon(aes(ymin = ci_low, ymax = ci_high),
alpha = 0.2, fill = "steelblue") +
# Línea de referencia en cero
geom_hline(yintercept = 0, linetype = "solid",
color = "black", linewidth = 0.5) +
# Línea vertical en el shock (período 0)
geom_vline(xintercept = -0.5, linetype = "dashed",
color = "red", linewidth = 1) +
# Línea de coeficientes
geom_line(color = "steelblue", linewidth = 1) +
# Puntos (diferentes para sig/no sig)
geom_point(aes(color = significativo, shape = significativo),
size = 3) +
# Etiquetas y tema
labs(
title = titulo,
subtitle = paste("Línea vertical roja:", fecha_shock_label),
x = "Meses relativos al shock",
y = "Efecto en Producción industrial\n(diferencia Tratamiento - Control)",
caption = "Notas: Bandas grises = IC 95%. Período -1 omitido como referencia.\nPuntos rojos = coeficientes estadísticamente significativos (IC no incluye cero)."
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
axis.title = element_text(size = 11),
legend.position = "bottom",
panel.grid.minor = element_blank()
) +
scale_color_manual(
name = "Significativo (99%):",
values = c("No" = "steelblue", "Sí" = "red")
) +
scale_shape_manual(
name = "Significativo (99%):",
values = c("No" = 16, "Sí" = 17)
) +
# Anotar el shock
annotate("text", x = 1, y = max(coefs_df$ci_high, na.rm = TRUE) * 0.99,
label = "Shock", color = "red", size = 4, hjust = 0)
return(p)
}
# Crear gráficos
p_event_imp <- plot_event_study(
coefs_imp,
"Event Study: Efecto Dinámico de la Importación de Gas (GNI)",
"Diciembre 2024"
)
# Mostrar
print(p_event_imp)
# Test conjunto: todos los coeficientes pre-shock = 0
test_pre_imp <- coefs_imp %>%
filter(periodo < -1) %>%
summarise(
n_coefs = n(),
n_sig = sum(ci_low > 0 | ci_high < 0),
max_abs_coef = max(abs(coef))
)
cat("SHOCK IMPORTACIÓN:\n")
cat("  N coeficientes pre-shock:", test_pre_imp$n_coefs, "\n")
cat("  N significativos:", test_pre_imp$n_sig, "\n")
cat("  Máximo coeficiente (abs):", round(test_pre_imp$max_abs_coef, 3), "\n")
if(test_pre_imp$n_sig == 0) {
cat("  ✅ Ningún coeficiente pre-shock significativo → Tendencias paralelas VÁLIDAS\n\n")
} else {
cat("  ⚠️  Algunos coeficientes pre-shock significativos → Posible violación\n\n")
}
cat("ANÁLISIS DE HETEROGENEIDAD\n")
# 1. HETEROGENEIDAD POR INDUSTRIA
cat("1. Estimando efectos por industria...\n")
# Crear variable de shock
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
}
# Modelo con triple interacción: Shock × Grupo × Industria
modelo_het_industria <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:industria +
Shock_Importacion:IVIG_3_dt +
Shock_Importacion:industria +
IVIG_3_dt:industria +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por industria estimado\n\n")
# Mostrar resultados
etable(modelo_het_industria,
title = "Heterogeneidad por Industria",
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × Vulnerable",
"cobertura" = "Cobertura de gas",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
# 2. HETEROGENEIDAD POR NIVEL DE VULNERABILIDAD (Continuo)
cat("\n2. Estimando efectos usando IVIG continuo...\n")
modelo_het_continuo <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_cont +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con IVIG continuo estimado\n\n")
etable(modelo_het_continuo,
title = "Efecto según Nivel de Vulnerabilidad (IVIG continuo)",
dict = c("Shock_Importacion:IVIG_3_cont" = "Importación × IVIG (continuo)",
"cobertura" = "Cobertura de gas",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
# 3. HETEROGENEIDAD POR DEPARTAMENTO ESPECÍFICO
cat("\n3. Estimando efectos por departamento\n")
# Calcular efecto promedio post-shock para cada departamento y grupo
efectos_depto_simple <- BD_0 %>%
mutate(
periodo = ifelse(Shock_Importacion == 1, "Post", "Pre")
) %>%
group_by(departamento, IVIG_3_dt, periodo) %>%
summarise(
prod_mean = mean(ind_prod_nominal, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = c(IVIG_3_dt, periodo),
values_from = prod_mean,
names_prefix = "prod_"
) %>%
mutate(
# Efecto DiD para cada departamento
efecto_did = (prod_1_Post - prod_1_Pre) - (prod_0_Post - prod_0_Pre)
) %>%
select(departamento, efecto_did) %>%
arrange(desc(efecto_did))
cat("✓ Efectos por departamento calculados\n\n")
# Mostrar tabla
kable(efectos_depto_simple,
format = "simple",
caption = "Efectos DiD por Departamento (Diferencias simples)",
digits = 3,
col.names = c("Departamento", "Efecto DiD"))
# Gráfico
ggplot(efectos_depto_simple, aes(x = reorder(departamento, efecto_did),
y = efecto_did)) +
geom_col(aes(fill = efecto_did > 0), alpha = 0.7) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
coord_flip() +
labs(title = "Efectos DiD por Departamento",
subtitle = "(Post - Pre) para Vulnerables vs Control",
x = "Departamento",
y = "Efecto DiD") +
theme_minimal() +
scale_fill_manual(values = c("TRUE" = "darkgreen", "FALSE" = "darkred"),
guide = "none")
cat("ANÁLISIS DE ROBUSTEZ\n")
# 1. ESPECIFICACIÓN ALTERNATIVA: Sin controles
cat("1. Modelo sin controles (solo efectos fijos)...\n")
modelo_rob_sincontroles <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo sin controles estimado\n\n")
# 2. ESPECIFICACIÓN ALTERNATIVA: Umbral alternativo (percentil 75)
cat("2. Modelo con umbral alternativo (P75)...\n")
# Calcular percentil 75 en período pre-tratamiento
p75_pre <- BD_0 %>%
filter(year == 2023) %>%
summarise(p75 = quantile(IVIG_3_cont, 0.75, na.rm = TRUE)) %>%
pull(p75)
BD_0 <- BD_0 %>%
mutate(IVIG_3_dt_p75 = ifelse(IVIG_3_cont >= p75_pre, 1, 0))
modelo_rob_p75 <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt_p75 + IVIG_3_dt_p75 +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con P75 estimado\n\n")
# 3. ESPECIFICACIÓN ALTERNATIVA: Efectos fijos más estrictos
cat("3. Modelo con efectos fijos departamento × año...\n")
BD_0 <- BD_0 %>%
mutate(depto_year = paste(departamento, year, sep = "_"))
modelo_rob_fe_estricto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
depto_year + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con FE estrictos estimado\n\n")
# 4. PLACEBO TEST: Shock falso 12 meses antes
cat("4. Placebo test (shock falso)...\n")
# Crear shock placebo 12 meses antes del verdadero
fecha_placebo <- fecha_pre_tratamiento %m-% months(12)
BD_placebo <- BD_0 %>%
filter(date < fecha_pre_tratamiento) %>%  # Solo período pre-tratamiento real
mutate(Shock_Placebo = ifelse(date >= fecha_placebo, 1, 0))
modelo_placebo <- feols(
ind_prod_nominal ~ Shock_Placebo:IVIG_3_dt + IVIG_3_dt +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_placebo,
cluster = ~departamento
)
cat("✓ Placebo test estimado\n\n")
cat("\n============================================================\n")
cat("ESTIMANDO MODELOS DiD\n")
cat("============================================================\n\n")
# ------------------------------------------------------------
# SHOCK IMPORTACIÓN (dic 2024)
# ------------------------------------------------------------
cat("Estimando modelos con Shock Importación...\n")
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
cat("→ Variable Shock_Importacion creada\n")
}
modelo_imp_m1 <- feols(
ind_prod_nominal ~ Shock_Importacion + Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura +
log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelos Importación estimados\n\n")
cat("\n============================================================\n")
cat("RESULTADOS - SHOCK IMPORTACIÓN (GNI)\n")
cat("============================================================\n\n")
etable(modelo_imp_m1,
title = "Efecto de la Importación de Gas (GNI) sobre Productividad Industrial",
tex = FALSE,
headers = c("Importación"),
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × Grupo Vulnerable",
"cobertura" = "Cobertura de gas",
"log(población)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
notes = c("Método 3:(Varianza inversa)",
"Errores estándar agrupados por departamento en paréntesis.",
"Efectos fijos por departamento y período (año-mes) incluidos.",
"El coeficiente de interés captura el efecto diferencial de la importación",
"en departamentos vulnerables (Grupo=1) relativo a departamentos control (Grupo=0)."),
fitstat = c("n","r2","wr2"),
digits = 4)
modelo_imp_m2 <- feols(
ind_prod_nominal ~ Shock_Importacion + Shock_Importacion:IVIG_3_dt + IVIG_3_dt +
cobertura +
log(poblacion) + log(SGP) + gestion_inst + autonomia_fisc + tramites|
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelos Importación estimados\n\n")
cat("\n============================================================\n")
cat("RESULTADOS - SHOCK IMPORTACIÓN (GNI)\n")
cat("============================================================\n\n")
etable(modelo_imp_m2,
title = "Efecto de la Importación de Gas (GNI) sobre Productividad Industrial",
tex = FALSE,
headers = c("Importación"),
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × Grupo Vulnerable",
"cobertura" = "Cobertura de gas",
"log(población)" = "log(Población)",
"log(SGP)" = "log(SGP)",
"gestion_inst" = "Gestión Institucional",
"autonomia_fisc" = "Autonomía Fiscal",
"tramites" = "Trámites"),
notes = c("Método 3:(Varianza inversa)",
"Errores estándar agrupados por departamento en paréntesis.",
"Efectos fijos por departamento y período (año-mes) incluidos.",
"El coeficiente de interés captura el efecto diferencial de la importación",
"en departamentos vulnerables (Grupo=1) relativo a departamentos control (Grupo=0)."),
fitstat = c("n","r2","wr2"),
digits = 4)
# TABLA COMPARATIVA DE ROBUSTEZ
cat("\nGenerando tabla comparativa de robustez...\n\n")
etable(modelo_imp_m1, modelo_rob_sincontroles, modelo_rob_p75,
modelo_rob_fe_estricto, modelo_placebo,
title = "Análisis de Robustez",
headers = c("Baseline", "Sin controles", "Umbral P75",
"FE estrictos", "Placebo"),
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × Vulnerable",
"Shock_Importacion:IVIG_3_dt_p75" = "Importación × Vulnerable (P75)",
"Shock_Placebo:IVIG_3_dt" = "Placebo × Vulnerable",
"cobertura" = "Cobertura",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
cat("\n✓ Análisis de heterogeneidad y robustez completado\n")
cat("============================================================\n\n")
