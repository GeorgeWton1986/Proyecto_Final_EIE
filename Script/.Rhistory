cat("✓ Tabla 1 guardada: primeros 5 registros\n")
# Crear matriz de presencia
matriz_presencia <- BD_0 %>%
select(industria, departamento) %>%
distinct() %>%
mutate(presencia = "Sí") %>%
pivot_wider(
names_from = departamento,
values_from = presencia,
values_fill = "No"
) %>%
arrange(industria)
# Ver cuántos departamentos tienes
num_departamentos <- ncol(matriz_presencia) - 1
cat("Número de departamentos:", num_departamentos, "\n")
# Dividir en grupos de 5 departamentos
deptos_por_tabla <- 5
# Obtener nombres de departamentos (todas las columnas excepto 'industria')
nombres_deptos <- colnames(matriz_presencia)[colnames(matriz_presencia) != "industria"]
# Dividir departamentos en grupos
grupos_deptos <- split(nombres_deptos,
ceiling(seq_along(nombres_deptos) / deptos_por_tabla))
# Crear una tabla por cada grupo
numero_tabla_base <- 2  # Número inicial
for (i in seq_along(grupos_deptos)) {
numero_tabla <- numero_tabla_base + (i - 1)
# Seleccionar industria + grupo de departamentos
deptos_grupo <- grupos_deptos[[i]]
matriz_grupo <- matriz_presencia %>%
select(industria, all_of(deptos_grupo))
cat(paste0("\nCreando tabla ", i, " de ", length(grupos_deptos),
" (Departamentos: ", paste(deptos_grupo, collapse = ", "), ")\n"))
# Crear tabla LaTeX
tabla_latex <- kable(matriz_grupo,
format = "latex",
booktabs = TRUE,
caption = paste0("Presencia de industrias por departamento (Parte ", i, " de ", length(grupos_deptos), ")"),
escape = TRUE)
# Guardar la tabla en un archivo
writeLines(as.character(tabla_latex), file.path(dir_tablas, "tabla_temp.tex"))
# Leer el contenido
tabla_contenido <- readLines(file.path(dir_tablas, "tabla_temp.tex"))
# Extraer contenido
inicio <- which(grepl("\\\\begin\\{document\\}", tabla_contenido))
fin <- which(grepl("\\\\end\\{document\\}", tabla_contenido))
if (length(inicio) > 0 && length(fin) > 0) {
tabla_limpia <- tabla_contenido[(inicio + 1):(fin - 1)]
} else {
tabla_limpia <- tabla_contenido
}
# Remover duplicados
tabla_limpia <- tabla_limpia[!grepl("^\\\\begin\\{table\\}|^\\\\end\\{table\\}|^\\\\centering$", tabla_limpia)]
# Crear documento completo
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{caption}",
"\\usepackage{longtable}",
"\\usepackage{array}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=0.5in, paperwidth=14in, paperheight=10in]{geometry}",
"\\pagestyle{empty}",
"\\begin{document}",
paste0("\\setcounter{table}{", numero_tabla - 1, "}"),
"\\begin{table}[htbp]",
"\\centering",
"\\large",  # Letra normal/grande (opciones: \\small, \\normalsize, \\large)
tabla_limpia,
"\\end{table}",
"\\end{document}"
)
# Nombre de archivo único
nombre_archivo <- paste0("matriz_presencia_parte_", i)
# Guardar archivo .tex
writeLines(doc_completo, file.path(dir_tablas, paste0(nombre_archivo, ".tex")))
# Compilar
dir_actual <- getwd()
setwd(dir_tablas)
resultado <- try({
tinytex::pdflatex(paste0(nombre_archivo, ".tex"))
}, silent = TRUE)
setwd(dir_actual)
if (!inherits(resultado, "try-error")) {
# Convertir a PNG
pdf_path <- file.path(dir_tablas, paste0(nombre_archivo, ".pdf"))
if (file.exists(pdf_path)) {
img <- image_read_pdf(pdf_path, density = 300)
image_write(img, file.path(dir_tablas, paste0(nombre_archivo, ".png")))
cat(paste0("✓ Tabla ", numero_tabla, " guardada: ", nombre_archivo, ".png\n"))
# Limpiar archivos temporales
archivos_eliminar <- c(
file.path(dir_tablas, paste0(nombre_archivo, ".pdf")),
file.path(dir_tablas, paste0(nombre_archivo, ".aux")),
file.path(dir_tablas, paste0(nombre_archivo, ".log"))
)
file.remove(archivos_eliminar[file.exists(archivos_eliminar)])
}
} else {
cat(paste0("❌ Error al compilar tabla ", i, "\n"))
# Mostrar el log si hay error
log_file <- file.path(dir_tablas, paste0(nombre_archivo, ".log"))
if (file.exists(log_file)) {
log_lines <- readLines(log_file)
cat(tail(log_lines, 20), sep = "\n")
}
}
}
# Limpiar archivo temporal
temp_file <- file.path(dir_tablas, "tabla_temp.tex")
if (file.exists(temp_file)) {
file.remove(temp_file)
}
cat("\n✓ Todas las tablas de matriz de presencia creadas\n")
cat(paste0("Total de tablas generadas: ", length(grupos_deptos), "\n"))
# Eliminar archivo temporal
unlink(temp_file)
