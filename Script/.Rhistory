cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por industria estimado\n\n")
# Mostrar resultados
etable(modelo_het_industria,
title = "Heterogeneidad por Industria",
dict = c("Shock_Importacion:IVIG_3_dt" = "Importación × Vulnerable",
"cobertura" = "Cobertura de gas",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
# 2. HETEROGENEIDAD POR NIVEL DE VULNERABILIDAD (Continuo)
cat("\n2. Estimando efectos usando IVIG continuo...\n")
modelo_het_continuo <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_cont +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con IVIG continuo estimado\n\n")
etable(modelo_het_continuo,
title = "Efecto según Nivel de Vulnerabilidad (IVIG continuo)",
dict = c("Shock_Importacion:IVIG_3_cont" = "Importación × IVIG (continuo)",
"cobertura" = "Cobertura de gas",
"log(poblacion)" = "log(Población)",
"log(SGP)" = "log(SGP)"),
fitstat = c("n", "r2", "wr2"),
digits = 4)
# 3. HETEROGENEIDAD POR DEPARTAMENTO ESPECÍFICO
cat("\n3. Estimando efectos por departamento\n")
# Calcular efecto promedio post-shock para cada departamento y grupo
efectos_depto_simple <- BD_0 %>%
mutate(
periodo = ifelse(Shock_Importacion == 1, "Post", "Pre")
) %>%
group_by(departamento, IVIG_3_dt, periodo) %>%
summarise(
prod_mean = mean(ind_prod_nominal, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = c(IVIG_3_dt, periodo),
values_from = prod_mean,
names_prefix = "prod_"
) %>%
mutate(
# Efecto DiD para cada departamento
efecto_did = (prod_1_Post - prod_1_Pre) - (prod_0_Post - prod_0_Pre)
) %>%
select(departamento, efecto_did) %>%
arrange(desc(efecto_did))
cat("✓ Efectos por departamento calculados\n\n")
# Mostrar tabla
kable(efectos_depto_simple,
format = "simple",
caption = "Efectos DiD por Departamento (Diferencias simples)",
digits = 3,
col.names = c("Departamento", "Efecto DiD"))
# Gráfico
ggplot(efectos_depto_simple, aes(x = reorder(departamento, efecto_did),
y = efecto_did)) +
geom_col(aes(fill = efecto_did > 0), alpha = 0.7) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
coord_flip() +
labs(title = "Efectos DiD por Departamento",
subtitle = "(Post - Pre) para Vulnerables vs Control",
x = "Departamento",
y = "Efecto DiD") +
theme_minimal() +
scale_fill_manual(values = c("TRUE" = "darkgreen", "FALSE" = "darkred"),
guide = "none")
# Verificar qué departamentos son Vulnerables vs Control
tabla_clasificacion <- BD_0 %>%
filter(year == 2023) %>%
group_by(departamento) %>%
summarise(
IVIG_promedio = mean(IVIG_3_cont, na.rm = TRUE),
Grupo = first(grupo_IVIG_3_label)
) %>%
arrange(desc(IVIG_promedio))
kable(tabla_clasificacion,
format = "simple",
caption = "Clasificación de Departamentos según IVIG",
digits = 3,
col.names = c("Departamento", "IVIG Promedio", "Grupo"))
