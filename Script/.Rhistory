# Extraer coeficientes
# Función para extraer coeficientes del event study
extraer_coefs_event <- function(modelo, nombre_var) {
# Obtener todos los coeficientes
coefs <- coef(modelo)
ses <- se(modelo)
# Filtrar solo los de interacción (nombres contienen el período)
indices <- grep(nombre_var, names(coefs))
# Extraer períodos de los nombres
# Ejemplo: "periodo_covid::-12:grupo_IVIG_3" → -12
periodos <- as.numeric(gsub(".*::([-]?[0-9]+):.*", "\\1", names(coefs)[indices]))
# Crear data frame
df <- data.frame(
periodo = periodos,
coef = coefs[indices],
se = ses[indices]
) %>%
mutate(
ci_low = coef - 1.96 * se,
ci_high = coef + 1.96 * se
) %>%
arrange(periodo)
# Agregar período de referencia (-1) con coef = 0
df_ref <- data.frame(
periodo = -1,
coef = 0,
se = 0,
ci_low = 0,
ci_high = 0
)
df <- bind_rows(df, df_ref) %>%
arrange(periodo)
return(df)
}
# Extraer coeficientes
coefs_imp <- extraer_coefs_event(modelo_event_imp, "periodo_imp")
cat("Coeficientes extraídos:\n")
cat("  Importación: N períodos =", nrow(coefs_imp), "\n\n")
# Gerenerar el gráfico de Evento
cat("Generando gráficos...\n\n")
# FUNCIÓN PARA GRAFICAR
plot_event_study <- function(coefs_df, titulo, fecha_shock_label) {
# Identificar período pre/post
coefs_df <- coefs_df %>%
mutate(
fase = ifelse(periodo < 0, "Pre-shock", "Post-shock"),
significativo = ifelse(ci_low > 0 | ci_high < 0, "Sí", "No")
)
p <- ggplot(coefs_df, aes(x = periodo, y = coef)) +
# Banda de confianza
geom_ribbon(aes(ymin = ci_low, ymax = ci_high),
alpha = 0.2, fill = "steelblue") +
# Línea de referencia en cero
geom_hline(yintercept = 0, linetype = "solid",
color = "black", linewidth = 0.5) +
# Línea vertical en el shock (período 0)
geom_vline(xintercept = -0.5, linetype = "dashed",
color = "red", linewidth = 1) +
# Línea de coeficientes
geom_line(color = "steelblue", linewidth = 1) +
# Puntos (diferentes para sig/no sig)
geom_point(aes(color = significativo, shape = significativo),
size = 3) +
# Etiquetas y tema
labs(
title = titulo,
subtitle = paste("Línea vertical roja:", fecha_shock_label),
x = "Meses relativos al shock",
y = "Efecto en indice de empleo\n(diferencia Tratamiento - Control)",
caption = "Notas: Bandas grises = IC 95%. Período -1 omitido como referencia.\nPuntos rojos = coeficientes estadísticamente significativos (IC no incluye cero)."
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
axis.title = element_text(size = 11),
legend.position = "bottom",
panel.grid.minor = element_blank()
) +
scale_color_manual(
name = "Significativo (95%):",
values = c("No" = "steelblue", "Sí" = "red")
) +
scale_shape_manual(
name = "Significativo (95%):",
values = c("No" = 16, "Sí" = 17)
) +
# Anotar el shock
annotate("text", x = 1, y = max(coefs_df$ci_high, na.rm = TRUE) * 0.9,
label = "Shock", color = "red", size = 4, hjust = 0)
return(p)
}
# Crear gráficos
p_event_imp <- plot_event_study(
coefs_imp,
"Event Study: Efecto Dinámico de la Importación de Gas (GNI)",
"Diciembre 2024"
)
