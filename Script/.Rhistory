# Puntos (diferentes para sig/no sig)
geom_point(aes(color = significativo, shape = significativo),
size = 3) +
# Etiquetas y tema
labs(
title = titulo,
subtitle = paste("Línea vertical roja:", fecha_shock_label),
x = "Meses relativos al shock",
y = "Efecto en Producción industrial\n(diferencia Tratamiento - Control)",
caption = "Notas: Bandas grises = IC 95%. Período -1 omitido como referencia.\nPuntos rojos = coeficientes estadísticamente significativos (IC no incluye cero)."
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
axis.title = element_text(size = 11),
legend.position = "bottom",
panel.grid.minor = element_blank()
) +
scale_color_manual(
name = "Significativo (99%):",
values = c("No" = "steelblue", "Sí" = "red")
) +
scale_shape_manual(
name = "Significativo (99%):",
values = c("No" = 16, "Sí" = 17)
) +
# Anotar el shock
annotate("text", x = 1, y = max(coefs_df$ci_high, na.rm = TRUE) * 0.99,
label = "Shock", color = "red", size = 4, hjust = 0)
ggsave("figura8_event_study.png", width = 10, height = 6)
return(p)
}
# Crear gráficos
p_event_imp <- plot_event_study(
coefs_imp,
"Figura 8: Event Study - Efecto Dinámico de la Importación de Gas (GNI)",
"Diciembre 2024"
)
# Mostrar
print(p_event_imp)
# Test conjunto: todos los coeficientes pre-shock = 0
test_pre_imp <- coefs_imp %>%
filter(periodo < -1) %>%
summarise(
n_coefs = n(),
n_sig = sum(ci_low > 0 | ci_high < 0),
max_abs_coef = max(abs(coef))
)
cat("SHOCK IMPORTACIÓN:\n")
cat("  N coeficientes pre-shock:", test_pre_imp$n_coefs, "\n")
cat("  N significativos:", test_pre_imp$n_sig, "\n")
cat("  Máximo coeficiente (abs):", round(test_pre_imp$max_abs_coef, 3), "\n")
if(test_pre_imp$n_sig == 0) {
cat("  ✅ Ningún coeficiente pre-shock significativo → Tendencias paralelas VÁLIDAS\n\n")
} else {
cat("  ⚠️  Algunos coeficientes pre-shock significativos → Posible violación\n\n")
}
cat("ANÁLISIS DE HETEROGENEIDAD\n")
# 1. HETEROGENEIDAD POR INDUSTRIA
cat("1. Estimando efectos por industria...\n")
# Crear variable de shock
if(!"Shock_Importacion" %in% colnames(BD_0)) {
BD_0 <- BD_0 %>%
mutate(Shock_Importacion = ifelse(date >= fecha_pre_tratamiento, 1, 0))
}
# Modelo con triple interacción: Shock × Grupo × Industria
modelo_het_industria <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:industria +
Shock_Importacion:IVIG_3_dt +
Shock_Importacion:industria +
IVIG_3_dt:industria +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por industria estimado\n\n")
# Mostrar resultados
etable(modelo_het_industria,
tex = FALSE,
title = "Heterogeneidad por Industria",
headers = c("Modelo Heterogéneo por Industria"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = "Notas: Errores estándar agrupados a nivel departamental entre paréntesis.",
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1)
# 2. HETEROGENEIDAD POR NIVEL DE VULNERABILIDAD (Continuo)
cat("\n2. Estimando efectos usando IVIG continuo...\n")
modelo_het_continuo <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_cont +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo con IVIG continuo estimado\n\n")
etable(modelo_het_continuo,
tex = FALSE,
title = "Efecto según Nivel de Vulnerabilidad (IVIG continuo)",
headers = c("IVIG Continuo"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = "Notas: Errores estándar agrupados a nivel departamental entre paréntesis.",
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1)
# 3. HETEROGENEIDAD POR DEPARTAMENTO ESPECÍFICO
cat("\n3. Estimando efectos por departamento\n")
# Modelo con interacciones departamento × shock
modelo_het_depto <- feols(
ind_prod_nominal ~ Shock_Importacion:IVIG_3_dt:departamento +
cobertura + log(poblacion) + log(SGP) |
departamento + ym_2,
data = BD_0,
cluster = ~departamento
)
cat("✓ Modelo por departamento estimado\n\n")
etable(modelo_het_depto,
tex = FALSE,
title = "Heterogeneidad por departamento",
headers = c("Modelo Heterogéneo por Departamento"),
drop = "cobertura|poblacion|SGP|^ym_2$|^departamento$",
notes = "Notas: Errores estándar agrupados a nivel departamental entre paréntesis.",
fontsize = "small",
se.below = FALSE,
digits = 4,
digits.stats = 1)
# Extraer coeficientes de departamentos
coefs_depto <- coef(modelo_het_depto)
nombres_depto <- names(coefs_depto)[grepl("departamento", names(coefs_depto))]
valores_depto <- coefs_depto[nombres_depto]
# Limpiar nombres
nombres_limpios <- gsub("Shock_Importacion:IVIG_3_dt:departamento", "", nombres_depto)
# Crear dataframe
df_plot <- data.frame(
departamento = nombres_limpios,
coef = valores_depto,
se = se(modelo_het_depto)[nombres_depto]
) %>%
mutate(
ci_low = coef - 1.96 * se,
ci_high = coef + 1.96 * se,
significativo = ifelse(ci_low > 0 | ci_high < 0, "Sí", "No")
)
# Gráfico
ggplot(df_plot, aes(x = reorder(departamento, coef), y = coef)) +
geom_point(aes(color = significativo), size = 3) +
geom_errorbar(aes(ymin = ci_low, ymax = ci_high, color = significativo),
width = 0.2, linewidth = 1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
coord_flip() +
labs(title = "Efectos Heterogéneos por Departamento",
subtitle = "Shock Importación × Vulnerabilidad (con IC 95%)",
x = "Departamento",
y = "Efecto estimado",
color = "Significativo (5%)") +
theme_minimal() +
scale_color_manual(values = c("No" = "gray", "Sí" = "red"))
